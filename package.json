{
  "name": "@linkiez/primeng-dynamic-form",
  "version": "1.0.0",
  "private": true,
  "description": "NPM package providing an Angular 22 + PrimeNG 22 dynamic form library",
  "scripts": {
    "build": "npx ng-packagr -p packages/dynamic-form/ng-package.json",
    "build:demo": "npx ng build demo --configuration production",
    "serve:demo": "npx ng serve demo --configuration development",
    "test": "jest --testPathPatterns='tests/unit'",
    "test:integration": "jest --testPathPatterns='tests/integration'",
    "test:contract": "jest --testPathPatterns='tests/contract'",
    "test:all": "jest",
    "lint": "eslint 'packages/dynamic-form/src/**/*.ts'",
    "release": "semantic-release"
  },
  "dependencies": {
    "@angular/animations": "^22.1.0",
    "@angular/cdk": "^22.1.0",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/platform-browser-dynamic": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@primeuix/themes": "2.0.3",
    "primeng": "22.1.1",
    "rxjs": "^7.8.0",
    "tslib": "^2.6.0",
    "zone.js": "^0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.0",
    "@angular/cli": "^22.1.0",
    "@angular/compiler-cli": "^22.1.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.8",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/jest": "^30.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "jest-preset-angular": "^14.4.0",
    "ng-packagr": "^22.1.0",
    "semantic-release": "^25.0.3",
    "typescript": "~6.0.0"
  },
  "packageManager": "yarn@4.14.1"
}
