{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/spec",
    "types": ["jest"],
    "esModuleInterop": true,
    "isolatedModules": true,
    "module": "Node16",
    "moduleResolution": "node16",
    "paths": {
      "@linkiez/primeng-dynamic-form": ["packages/dynamic-form/src/public-api.ts"],
      "primeng/*": ["node_modules/primeng/types/primeng-*"]
    }
  },
  "include": [
    "tests/**/*.ts",
    "packages/**/*.spec.ts",
    "jest.setup.ts"
  ]
}
